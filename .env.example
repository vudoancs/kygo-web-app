# Public (exposed to browser — never put secrets here)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL tới kygo-erp-api (gồm prefix /api/v1). Trùng PORT trong kygo-erp-api/.env (mặc định 5001, không phải 50001).
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Google OAuth (Client ID) — lấy từ Google Cloud Console (OAuth 2.0 Client IDs)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# VietQR động (số tiền + nội dung CK có mã đơn)
# Tra mã BIN: https://vietqr.io/danh-sach-ngan-hang (VD: MB Bank = 970422)
NEXT_PUBLIC_SHOP_BANK_BIN=970422
NEXT_PUBLIC_SHOP_BANK_ACCOUNT=
NEXT_PUBLIC_SHOP_BANK_NAME=MB Bank
NEXT_PUBLIC_SHOP_ACCOUNT_NAME=KYGO PROM

# Server-only (optional BFF / server actions calling Nest)
# API_SERVER_URL=http://nestjs:4000/api
